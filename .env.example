NODE_ENV=production
IMAGE_REGISTRY=docker.io
PORT=3000
HOST=0.0.0.0
POSTGRES_DB=sinoherb
POSTGRES_USER=sinoherb
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://sinoherb:replace-with-a-long-random-password@postgres:5432/sinoherb
SESSION_SECRET=replace-with-at-least-32-random-characters
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
CONFIG_ENCRYPTION_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=900
CHAT_RETENTION_DAYS=7
CART_RETENTION_DAYS=30
CUSTOMER_SESSION_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14
MEDIA_UPLOAD_DIR=/app/uploads
MEDIA_MAX_BYTES=5242880
MEDIA_BACKUP_LIMIT=10
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=15000
